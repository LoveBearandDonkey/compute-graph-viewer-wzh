# Copy this file to /etc/ascend-tiling-visualizer.env on the server.
# Per-user access keys contain hashes only. Keep the mounted data directory private.
MCP_ACCESS_KEYS_FILE=/data/access-keys.json
MCP_USAGE_FILE=/data/usage.json
MCP_PER_USER_RATE_PER_MINUTE=30
# Optional migration fallback. Remove after the legacy owner token has been imported.
# MCP_AUTH_TOKEN=replace-with-a-long-random-token
MCP_OWNER_DAILY_LIMIT=2000
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_MAX_BODY_BYTES=2097152
# Comma-separated exact origins. Requests without Origin remain allowed for native MCP clients.
MCP_ALLOWED_ORIGINS=
