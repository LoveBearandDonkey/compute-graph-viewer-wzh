[Unit]
Description=Ascend C Tiling Visualizer MCP server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ascend-tiling-visualizer
EnvironmentFile=/etc/ascend-tiling-visualizer.env
ExecStart=/usr/bin/node /opt/ascend-tiling-visualizer/server.js
Restart=on-failure
RestartSec=3
User=ascendmcp

[Install]
WantedBy=multi-user.target
