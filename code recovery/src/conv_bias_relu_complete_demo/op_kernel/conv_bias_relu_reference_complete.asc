/*
 * Fixed-shape Conv2D + Bias + ReLU execution reference.
 *
 * Concrete demo:
 *   X logical:       [1, 16, 8, 8], FP16
 *   W logical:       [32, 16, 3, 3], FP16
 *   Bias:            [32], FP32
 *   Y logical:       [1, 32, 8, 8], FP16
 *   stride:          1 x 1
 *   padding:         1 x 1 x 1 x 1
 *   dilation:        1 x 1
 *
 * Cube view:
 *   A[64, 144] * B[144, 32] + Bias[32] -> C[64, 32]
 *   tileM = tileK = tileN = 16
 *   M tiles: M0..M3; K tiles: K0..K8; N tiles: N0..N1
 *   output tiles: OT0..OT7; one AI Core handles one output tile.
 *
 * Physical GM contracts used by this reference:
 *   feature: NC1HWC0 [N, C1, H, W, C0] = [1, 1, 8, 8, 16]
 *   weight:  ND [K, Co] = [144, 32]
 *            This is the physical transpose/flattening of logical OIHW W.
 *   bias:    ND [Co] = [32]
 *   output:  ND [M, Co] = [64, 32], equivalent to NHWC [1, 8, 8, 32]
 *
 * The output is intentionally emitted as row-major [M, Co] so Fixpipe can
 * perform CO1(NZ) -> GM(ND) directly. A separate layout conversion is required
 * when a downstream contract strictly requires NCHW [1, 32, 8, 8].
 */

#include "kernel_operator.h"
#include "conv_bias_relu_tiling_data.h"

namespace {
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t DATABLOCK_BYTES = 32;
constexpr uint32_t BT_BURST_BYTES = 64;

constexpr uint32_t AlignUp(uint32_t value, uint32_t align)
{
    return (value + align - 1U) / align * align;
}
}  // namespace

class KernelConvBiasReluReferenceComplete {
public:
    __aicore__ inline void Init(
        GM_ADDR feature,
        GM_ADDR weight,
        GM_ADDR bias,
        GM_ADDR output,
        const ConvBiasReluTilingData& tiling)
    {
        tiling_ = tiling;
        outputTileIndex_ = AscendC::GetBlockIdx();
        active_ = outputTileIndex_ < tiling_.outputTileCount;
        if (!active_) {
            return;
        }

        mTileIndex_ = outputTileIndex_ / tiling_.nTiles;
        nTileIndex_ = outputTileIndex_ % tiling_.nTiles;
        mStart_ = mTileIndex_ * tiling_.tileM;
        nStart_ = nTileIndex_ * tiling_.tileN;

        featureGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ half*>(feature), tiling_.featureGmElements);
        weightGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ half*>(weight), tiling_.weightGmElements);
        biasGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ float*>(bias), tiling_.biasGmElements);
        outputGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ half*>(output), tiling_.outputGmElements);
    }

    __aicore__ inline void Process()
    {
        if (!active_) {
            return;
        }

        // ------------------------------------------------------------------
        // Static local-memory map. A1, B1 and C1 share the physical L1 Buffer,
        // so their byte ranges must not overlap.
        // ------------------------------------------------------------------
        constexpr uint32_t FM_A1_ADDR = 0;                 // 512B aligned
        const uint32_t fmA1Bytes = tiling_.fmapA1Elements * sizeof(half);
        const uint32_t weightB1Addr = AlignUp(FM_A1_ADDR + fmA1Bytes, 512);
        const uint32_t weightB1Bytes = tiling_.weightB1Elements * sizeof(half);
        const uint32_t biasC1Addr = AlignUp(weightB1Addr + weightB1Bytes, 128);

        auto fmapA1 = AscendC::LocalTensor<half>(
            AscendC::TPosition::A1, FM_A1_ADDR, tiling_.fmapA1Elements);
        auto weightB1 = AscendC::LocalTensor<half>(
            AscendC::TPosition::B1, weightB1Addr, tiling_.weightB1Elements);
        auto biasC1 = AscendC::LocalTensor<float>(
            AscendC::TPosition::C1, biasC1Addr, tiling_.biasTileElements);

        // A2, B2, C2 and CO1 are distinct physical buffers; address 0 is valid
        // and satisfies the required alignment in each buffer.
        auto fmapA2 = AscendC::LocalTensor<half>(
            AscendC::TPosition::A2, 0, tiling_.fmapA2Elements);
        auto weightB2 = AscendC::LocalTensor<half>(
            AscendC::TPosition::B2, 0, tiling_.weightB2Elements);
        auto biasC2 = AscendC::LocalTensor<float>(
            AscendC::TPosition::C2, 0, tiling_.biasTileElements);
        auto accumCo1 = AscendC::LocalTensor<float>(
            AscendC::TPosition::CO1, 0, tiling_.accumCo1Elements);

        // TRACE 01: GM -> L1, executed by MTE2.
        // X0 is copied as complete NC1HWC0 [1,1,8,8,16].
        // Wj is the selected [K, tileN] column slice of weight ND [K,Co].
        // Dj is the selected Bias[tileN].
        CopyFeatureGmToA1(fmapA1);              // X0 -> A1
        CopyWeightNTileGmToB1(weightB1);        // W[Nj] -> B1, ND -> NZ
        CopyBiasNTileGmToC1(biasC1);            // D[Nj] -> C1

        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);

        // TRACE 02: C1(L1) -> C2(Bias Table), executed before Cube reads Bias.
        // This transfer uses a 64-byte burst unit on the L1 -> BT path.
        AscendC::DataCopy(
            biasC2,
            biasC1,
            {1, static_cast<uint16_t>(
                    tiling_.biasTileElements * sizeof(float) / BT_BURST_BYTES), 0, 0});

        // TRACE 03..11: nine K iterations for current output tile C[Mi,Nj].
        // Iteration Ik consumes A[Mi,Kk] and B[Kk,Nj]. I0 also consumes D[Nj].
        for (uint32_t kTileIndex = 0; kTileIndex < tiling_.kTiles; ++kTileIndex) {
            const uint32_t kOffset = kTileIndex * tiling_.tileK;

            // A2/B2 are single-buffered. Before overwriting them, MTE1 waits
            // until the previous Mmad has completed reading the old contents.
            if (kTileIndex > 0) {
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
            }

            LoadFmapWindow3D(fmapA2, fmapA1, kOffset);   // A[Mi,Kk]
            LoadWeightKTileToL0B(weightB2, weightB1, kTileIndex); // B[Kk,Nj]

            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);

            AscendC::MmadParams params {};
            params.m = static_cast<uint16_t>(tiling_.tileM);
            params.n = static_cast<uint16_t>(tiling_.tileN);
            params.k = static_cast<uint16_t>(tiling_.tileK);
            params.unitFlag = 0;
            params.cmatrixInitVal = false;
            params.cmatrixSource = false;

            if (kTileIndex == 0) {
                // I0: C0[Mi,Nj] = A[Mi,K0] * B[K0,Nj] + D[Nj].
                // The overload detects that the initial matrix resides in C2.
                AscendC::Mmad(accumCo1, fmapA2, weightB2, biasC2, params);
            } else {
                // Ik: Ck[Mi,Nj] = C(k-1)[Mi,Nj]
                //                    + A[Mi,Kk] * B[Kk,Nj].
                // cmatrixInitVal=false and cmatrixSource=false select CO1.
                AscendC::Mmad(accumCo1, fmapA2, weightB2, params);
            }
        }

        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);

        // TRACE 12: CO1 -> GM, executed by Fixpipe.
        // [16,16] FP32 NZ -> [16,16] FP16 ND, with ReLU fused.
        AscendC::FixpipeParamsV220 fixpipe {};
        fixpipe.nSize = static_cast<uint16_t>(tiling_.tileN);
        fixpipe.mSize = static_cast<uint16_t>(tiling_.tileM);
        fixpipe.srcStride = static_cast<uint16_t>(tiling_.tileM);
        fixpipe.dstStride = tiling_.co;  // row length of output ND [M, Co]
        fixpipe.quantPre = QuantMode_t::F322F16;
        fixpipe.deqScalar = 0;
        fixpipe.ndNum = 1;
        fixpipe.srcNdStride = 0;
        fixpipe.dstNdStride = 0;
        fixpipe.reluEn = true;
        fixpipe.unitFlag = 0;
        fixpipe.isChannelSplit = false;

        const uint32_t outputOffset = mStart_ * tiling_.co + nStart_;
        AscendC::Fixpipe(outputGm_[outputOffset], accumCo1, fixpipe);
    }

private:
    __aicore__ inline void CopyFeatureGmToA1(AscendC::LocalTensor<half> dst)
    {
        const uint16_t blockLen = static_cast<uint16_t>(
            tiling_.fmapA1Elements * sizeof(half) / DATABLOCK_BYTES);
        AscendC::DataCopy(dst, featureGm_, {1, blockLen, 0, 0});
    }

    __aicore__ inline void CopyWeightNTileGmToB1(AscendC::LocalTensor<half> dst)
    {
        // Source is ND [K, Co]. Starting at column nStart selects one N tile.
        // The source row stride remains Co; DataCopy packs [K,tileN] into B1 NZ.
        AscendC::Nd2NzParams params {};
        params.ndNum = 1;
        params.nValue = static_cast<uint16_t>(tiling_.k);
        params.dValue = static_cast<uint16_t>(tiling_.tileN);
        params.srcNdMatrixStride = 0;
        params.srcDValue = static_cast<uint16_t>(tiling_.co);
        params.dstNzC0Stride = static_cast<uint16_t>(tiling_.k);
        params.dstNzNStride = 1;
        params.dstNzMatrixStride = 0;
        AscendC::DataCopy(dst, weightGm_[nStart_], params);
    }

    __aicore__ inline void CopyBiasNTileGmToC1(AscendC::LocalTensor<float> dst)
    {
        const uint16_t blockLen = static_cast<uint16_t>(
            tiling_.biasTileElements * sizeof(float) / DATABLOCK_BYTES);
        AscendC::DataCopy(dst, biasGm_[nStart_], {1, blockLen, 0, 0});
    }

    __aicore__ inline void LoadFmapWindow3D(
        AscendC::LocalTensor<half> dst,
        AscendC::LocalTensor<half> src,
        uint32_t kOffset)
    {
        AscendC::LoadData3DParamsV2<half> params {};
        params.padList[0] = static_cast<uint8_t>(tiling_.padLeft);
        params.padList[1] = static_cast<uint8_t>(tiling_.padRight);
        params.padList[2] = static_cast<uint8_t>(tiling_.padTop);
        params.padList[3] = static_cast<uint8_t>(tiling_.padBottom);
        params.l1H = static_cast<uint16_t>(tiling_.hi);
        params.l1W = static_cast<uint16_t>(tiling_.wi);
        params.channelSize = static_cast<uint16_t>(tiling_.ci);
        params.kExtension = static_cast<uint16_t>(tiling_.tileK);
        params.mExtension = static_cast<uint16_t>(tiling_.tileM);
        params.kStartPt = static_cast<uint16_t>(kOffset);
        params.mStartPt = static_cast<uint16_t>(mStart_);
        params.strideW = static_cast<uint8_t>(tiling_.strideW);
        params.strideH = static_cast<uint8_t>(tiling_.strideH);
        params.filterW = static_cast<uint8_t>(tiling_.kw);
        params.filterH = static_cast<uint8_t>(tiling_.kh);
        params.dilationFilterW = static_cast<uint8_t>(tiling_.dilationW);
        params.dilationFilterH = static_cast<uint8_t>(tiling_.dilationH);
        params.enTranspose = false;
        params.enSmallK = false;
        params.padValue = static_cast<half>(0.0f);
        params.filterSizeW = false;
        params.filterSizeH = false;
        params.fMatrixCtrl = false;
        AscendC::LoadData(dst, src, params);
    }

    __aicore__ inline void LoadWeightKTileToL0B(
        AscendC::LocalTensor<half> dst,
        AscendC::LocalTensor<half> src,
        uint32_t kTileIndex)
    {
        // B1 holds NZ [K,tileN]. Each K tile is one 16x16, 512-byte fractal.
        // Transposing that fractal produces the ZN layout expected in B2.
        AscendC::LoadData2DParams params {};
        params.startIndex = static_cast<uint16_t>(kTileIndex);
        params.repeatTimes = 1;
        params.srcStride = 1;
        params.sid = 0;
        params.dstGap = 0;
        params.ifTranspose = true;
        params.addrMode = false;
        AscendC::LoadData(dst, src, params);
    }

private:
    AscendC::GlobalTensor<half> featureGm_;
    AscendC::GlobalTensor<half> weightGm_;
    AscendC::GlobalTensor<float> biasGm_;
    AscendC::GlobalTensor<half> outputGm_;

    ConvBiasReluTilingData tiling_ {};
    uint32_t outputTileIndex_ = 0;
    uint32_t mTileIndex_ = 0;
    uint32_t nTileIndex_ = 0;
    uint32_t mStart_ = 0;
    uint32_t nStart_ = 0;
    bool active_ = false;
};

extern "C" __global__ __cube__ void conv_bias_relu_reference_complete(
    GM_ADDR feature,
    GM_ADDR weight,
    GM_ADDR bias,
    GM_ADDR output,
    GM_ADDR workspace,
    GM_ADDR tilingGm)
{
    (void)workspace;
    REGISTER_TILING_DEFAULT(ConvBiasReluTilingData);
    GET_TILING_DATA(tilingData, tilingGm);

    KernelConvBiasReluReferenceComplete op;
    op.Init(feature, weight, bias, output, tilingData);
    op.Process();
}
